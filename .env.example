# Database Configuration
# PostgreSQL connection string for production
DATABASE_URL=postgresql://username:password@localhost:5432/strapi_db

# PostgreSQL connection string for development (if different from production)
DATABASE_PUBLIC_URL=postgresql://username:password@localhost:5432/strapi_db_dev

# Server Configuration
# Host address (default: 0.0.0.0)
HOST=0.0.0.0

# Port number (default: 1337)
PORT=1337

# Application URL (used for CORS and webhooks)
URL=http://localhost:1337

# Application Keys (comma-separated array of keys for encryption)
APP_KEYS=your-app-key-1,your-app-key-2,your-app-key-3,your-app-key-4

# Admin Panel Configuration
# JWT secret for admin authentication
ADMIN_JWT_SECRET=your-admin-jwt-secret-key

# API Token salt for generating API tokens
API_TOKEN_SALT=your-api-token-salt

# Transfer token salt for data transfer operations
TRANSFER_TOKEN_SALT=your-transfer-token-salt

# JWT Configuration
# JWT secret for users-permissions plugin
JWT_SECRET=your-jwt-secret-key

# Webhooks Configuration
# Whether to populate relations in webhooks (default: false)
WEBHOOKS_POPULATE_RELATIONS=false

# Feature Flags
# Enable/disable NPS (Net Promoter Score) feature (default: true)
FLAG_NPS=true

# Enable/disable promotion of Enterprise Edition features (default: true)
FLAG_PROMOTE_EE=true
